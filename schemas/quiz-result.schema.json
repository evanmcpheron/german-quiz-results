{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-result.schema.json",
  "title": "German Quiz Result",
  "type": "object",
  "required": [
    "schema_version",
    "quiz_id",
    "completed_at",
    "topic",
    "level",
    "difficulty",
    "score",
    "max_score",
    "result",
    "questions",
    "strength_concept_ids",
    "review_concept_ids",
    "next_focus_concept_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "quiz_id": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "max_score": {
      "const": 10
    },
    "result": {
      "enum": [
        "difficulty_passed_next_harder",
        "remain_current_difficulty",
        "difficulty_will_be_reduced"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "number",
          "question_type",
          "prompt",
          "learner_answer",
          "accepted_answer",
          "target_concept_ids",
          "assessment",
          "credit"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "question_type": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "learner_answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "accepted_answer": {
            "type": "string",
            "minLength": 1
          },
          "target_concept_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assessment": {
            "enum": [
              "correct",
              "incorrect",
              "understandable_but_grammatically_incorrect",
              "grammatically_acceptable_but_unnatural"
            ]
          },
          "credit": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "explanation_summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "strength_concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_focus_concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
