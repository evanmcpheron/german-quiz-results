{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept-registry.schema.json",
  "title": "German Concept Registry",
  "type": "object",
  "required": [
    "schema_version",
    "concepts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "concepts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "category",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "level_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
